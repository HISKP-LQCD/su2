# if you run `u1-main` with this input file, i.e. by calling `u1-main -f main.input`, 
# you should get an output similar to what reported at the end of this document

geometry:
  X: 3
  Y: 3
  Z: 1
  T: 3
  ndims: 3

monomials:
  gauge:
    beta: 1.650000
    anisotropic:
      xi: 1

metropolis:
  do_mcmc: true
  conf_dir: ./conf
  conf_basename: config_u1
  n_meas: 30
  N_save: 10
  delta: 0.606061
  restart_condition: hot
  lenghty_conf_name: true

omeas:
  offline:
    conf_dir: ./conf
    lenghty_conf_name: true

  res_dir: .
  icounter: 0
  n_meas: 30
  nstep: 10
  potential:
    potentialplanar: false 
    potentialnonplanar: true
    sizeWloops: 0.5
    n_apesmear: 0
    alpha: 1
    append: true



